# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Generated at runtime (rebuilt by `python -m breathsim.story_db`)
data/*.db

# Local user data lives outside the repo (~/.breathsim); never commit it.

# Exported audio / screenshots produced by the app
/exports/
*.wav

# Secrets / API keys -- NEVER commit. The Anthropic key is the user's own and is
# stored only in env / OS keychain / a chmod-600 ~/.breathsim file / session memory.
.env
.env.*
*.env
secrets/
*secret*
*.key
*.pem
*_key.json
**/llm.json
**/llm_keys*.json
*api*key*
.anthropic
.claude_key

# LLM-generated, user-installed plugins are local + experimental -- never committed.
/plugins/

# Static web site build output (scripts/build_static.py)
site/
