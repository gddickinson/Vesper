//  KokoroOnnxBackend.swift   ← copy to Vesper/Audio/Neural/ (drop the .template)
//  Vesper — Kokoro neural-TTS backend via sherpa-onnx (verified against v1.13.3).
//
//  Prerequisites (see docs/KOKORO_SHERPA_WALKTHROUGH.md):
//   • sherpa-onnx.xcframework + onnxruntime.xcframework added (Embed & Sign)
//   • SherpaOnnx.swift copied into Vesper/Audio/Neural/
//   • a bridging header importing "sherpa-onnx/c-api/c-api.h"
//   • a bundled `kokoro` folder reference (model.onnx, voices.bin, tokens.txt,
//     espeak-ng-data/, lexicon-us-en.txt, lexicon-gb-en.txt)
//
//  Register at launch in VesperApp.swift:
//      init() { NeuralTTS.backend = KokoroOnnxBackend() }

import Foundation

final class KokoroOnnxBackend: NeuralTTSBackend {
    private let tts: SherpaOnnxOfflineTtsWrapper

    init?() {
        guard KokoroModel.isDownloaded,
              let tokens = KokoroModel.resolvedTokens?.path,
              let dataDir = KokoroModel.resolvedDataDir?.path else { return nil }

        var kokoro = sherpaOnnxOfflineTtsKokoroModelConfig(
            model: KokoroModel.resolvedModel.path,
            voices: KokoroModel.resolvedVoices.path,
            tokens: tokens,
            dataDir: dataDir,
            lexicon: KokoroModel.resolvedLexicon   // "" is fine for espeak-only models
        )
        var model = sherpaOnnxOfflineTtsModelConfig(
            kokoro: kokoro, numThreads: 2, debug: 0, provider: "cpu")
        var config = sherpaOnnxOfflineTtsConfig(model: model)
        tts = SherpaOnnxOfflineTtsWrapper(config: &config)
    }

    func synthesize(text: String, voiceID: String, speed: Float)
        -> (samples: [Float], sampleRate: Double)? {
        // `sid` indexes the speakers in voices.bin. KokoroCatalog order is
        // best-effort for this model — if a voice sounds wrong, reorder the
        // catalog (the audio is correct, only the label may be off).
        let sid = KokoroCatalog.all.firstIndex { $0.id == voiceID } ?? 0
        let audio = tts.generate(text: text, sid: Int(sid), speed: speed)
        guard !audio.samples.isEmpty else { return nil }
        return (audio.samples, Double(audio.sampleRate))   // Kokoro = 24000 Hz
    }
}
